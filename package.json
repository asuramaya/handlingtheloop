{
  "name": "htl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based, serverless DJ software that mixes public YouTube playlists, rekordbox-style.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.node.json",
    "worker": "vite build && rm -rf dist/models && wrangler dev",
    "worker:lan": "vite build && rm -rf dist/models && wrangler dev --ip 0.0.0.0",
    "worker:lan:https": "vite build && rm -rf dist/models && wrangler dev --ip 0.0.0.0 --local-protocol https",
    "deploy": "vite build && wrangler deploy",
    "deploy:admin": "wrangler deploy -c wrangler.admin.jsonc",
    "test": "vitest run",
    "check": "tsc -b && tsc -p tsconfig.node.json && vitest run"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0",
    "youtubei.js": "^17.2.0"
  }
}
