{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htl",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Hard per-invocation CPU ceiling (default is 30 s). Nothing here is CPU-bound — the Worker
  // proxies/streams (I/O) and ALL heavy DSP runs in the browser — so 1 s is a generous runaway
  // backstop a normal request can never trip, but it caps a pathological loop's CPU-ms bill.
  "limits": { "cpu_ms": 1000 },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker before serving static assets so it can stamp the
    // cross-origin-isolation headers (COOP/COEP) on the SPA document — otherwise
    // assets are served directly, the Worker never runs, and
    // `crossOriginIsolated` stays false (no threaded WASM for stem separation).
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "htl-audio" }],
  // SaaS layer: accounts + playlist sync. Create with `wrangler d1 create htl-db`
  // and paste the returned database_id below.
  "d1_databases": [{ "binding": "DB", "database_name": "htl-db", "database_id": "51b1e56c-fd95-42ef-b7b4-ddbebcf0e311" }],
  // Shared DJ session ("rooms"): one DjRoom Durable Object per account coordinates
  // a live set across the account's devices. SQLite-backed (runs locally under
  // `wrangler dev`). See server/room.ts and docs/shared-session.md.
  // RelayRoom (D2) shards the anonymous broadcast crowd past the single-DO ~500 ceiling; dormant
  // unless RELAY_SHARDS>0 (set in vars/.dev.vars). See server/relayRoom.ts.
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "DjRoom" },
      { "name": "RELAY", "class_name": "RelayRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DjRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RelayRoom"] }
  ],
  "routes": [
    { "pattern": "handlingtheloop.com", "custom_domain": true },
    { "pattern": "www.handlingtheloop.com", "custom_domain": true }
  ],
  // Per-IP rate limiting on the unauthenticated write/resolve paths (server/security.ts
  // `allow()` consults these; absent in `vite` dev → no-op). Tightened to protect the $5 plan's
  // included allowances from a single abusive IP without touching real users (no human contributes
  // 30×/min or cold-resolves 60 NEW tracks/min). RL_WRITE: catalog/analysis/stem contributions
  // (30/min); RL_AUDIO: cold-cache YouTube resolves → R2 writes (60/min).
  // `period` must be 10 or 60; namespace_id is any unique per-account integer.
  "unsafe": {
    "bindings": [
      { "name": "RL_WRITE", "type": "ratelimit", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
      { "name": "RL_AUDIO", "type": "ratelimit", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
      // AcoustID's free tier is ~3 lookups/sec — cap outbound at 30/10s ACROSS the
      // whole account so we never leech their service (the D1 cache absorbs the rest).
      { "name": "RL_ACOUSTID", "type": "ratelimit", "namespace_id": "2003", "simple": { "limit": 30, "period": 10 } }
    ]
  },
  "observability": { "enabled": true }
}
